<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Configuração consolidada para tipos MIME e cache -->
        <staticContent>
            <mimeMap fileExtension=".webp" mimeType="image/webp" />
            <mimeMap fileExtension=".avif" mimeType="image/avif" />
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
        </staticContent>
        
        <!-- Configuração para compressão -->
        <httpCompression>
            <dynamicTypes>
                <add mimeType="image/webp" enabled="true" />
            </dynamicTypes>
            <staticTypes>
                <add mimeType="image/webp" enabled="true" />
            </staticTypes>
        </httpCompression>
    </system.webServer>
</configuration>
